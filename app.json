{
  "expo": {
    "name": "Luna",
    "slug": "luna-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "react-native-iap"
    ],
    "ios": {
      "supportsTabletMode": false,
      "bundleIdentifier": "com.luna.app"
    },
    "android": {
      "package": "com.luna.app",
      "versionCode": 1
    },
    "web": {
      "display": "standalone",
      "backgroundColor": "#fffaf8"
    }
  }
}
