# Copy this file to .env and fill these values from Firebase Console.
# EXPO_PUBLIC_ values are visible in the compiled app. Do not place service-account
# keys, private keys, payment secrets, or server tokens in this file.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
